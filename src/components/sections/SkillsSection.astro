---
import SkillChip from '@/components/ui/SkillChip.astro';
import Section from '@/components/ui/Section.astro';
import { SECTION } from '@/data/navigation';
import { skillGroups } from '@/data/skills';
---

<Section section={SECTION.skills}>
  <p class="hint" data-reveal>
    Each technology links to its official documentation.
  </p>
  <div class="groups">
    {skillGroups.map((group) => (
      <div class="group" data-reveal>
        <h3 class="group-title">{group.title}</h3>
        <ul class="skills" role="list">
          {group.skills.map((skill) => (
            <li>
              <SkillChip skill={skill} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  .hint {
    margin-block-end: 1.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .groups {
    display: grid;
    gap: 1.75rem;
  }

  .group-title {
    margin-block-end: 0.8rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
