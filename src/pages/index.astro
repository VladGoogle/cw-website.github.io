---
import Footer from '@/components/layout/Footer.astro';
import Sidebar from '@/components/layout/Sidebar.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import BookshelfSection from '@/components/sections/BookshelfSection.astro';
import CertificationsSection from '@/components/sections/CertificationsSection.astro';
import EducationSection from '@/components/sections/EducationSection.astro';
import ExperienceSection from '@/components/sections/ExperienceSection.astro';
import SkillsSection from '@/components/sections/SkillsSection.astro';
import { profile } from '@/data/profile';
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = `${profile.fullName} — ${profile.role}`;
---

<BaseLayout title={title} description={profile.tagline}>
  <div class="layout">
    <Sidebar />
    <div class="content">
      <main id="content" tabindex="-1">
        <AboutSection />
        <ExperienceSection />
        <SkillsSection />
        <EducationSection />
        <CertificationsSection />
        <BookshelfSection />
      </main>
      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    position: relative;
    z-index: 1;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  main:focus {
    outline: none;
  }

  @media (min-width: 64rem) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 46fr) minmax(0, 52fr);
      column-gap: 4rem;
    }

    .content {
      padding-block-start: var(--page-padding-block);
    }
  }
</style>
