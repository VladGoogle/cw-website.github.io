# Copy to `.env` and adjust before running `npm run build` for a production deploy.
# Both values are optional for local development.

# Public origin of the deployed site (used for canonical / Open Graph URLs).
# S3 website:     http://<bucket>.s3-website-<region>.amazonaws.com
# Custom domain:  https://cv.example.com
SITE_URL=

# Sub-path the site is served from: `/` for S3 or custom domains,
# `/<repo-name>` for a GitHub Pages project site. Set automatically in CI.
BASE_PATH=/
